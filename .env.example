# Copy to .env and fill in real values. Never commit .env.
# All of these are read as environment variables by the API host.

# PostgreSQL connection string.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=workouttracker;Username=workout;Password=REPLACE_WITH_DB_PASSWORD

# Symmetric signing key for access tokens. Minimum 32 characters.
# Generate one with: openssl rand -base64 48
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET
Jwt__Issuer=WorkoutTracker
Jwt__Audience=WorkoutTracker.Web

# Exact origin(s) of the deployed frontend. Wildcards are not permitted.
Cors__AllowedOrigins__0=https://REPLACE_WITH_FRONTEND_DOMAIN

# Set to false to make the deployment invite-only.
Auth__AllowRegistration=true

# Existing or future account that should receive the Admin role.
# The plain ADMIN_EMAIL name is also supported.
ADMIN_EMAIL=admin@example.com

# Directory for private progress photos. Use a mounted volume in production.
Storage__MediaRoot=/var/lib/workouttracker/media
