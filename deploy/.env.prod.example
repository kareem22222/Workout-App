# Copy to .env.prod at the repository root and fill in real values. Never commit it.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Password for the bundled Postgres container. Generate one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Access-token signing key. Minimum 32 characters; the API refuses to start otherwise.
#   openssl rand -base64 48
JWT_KEY=

# Hostname pointed at this server. Caddy provisions a certificate for it automatically.
# Before DNS is ready, set this to the literal :80 to serve plain HTTP by IP address.
WORKOUT_DOMAIN=workout.example.com

# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Set to false once everyone has an account, to close off public sign-up.
ALLOW_REGISTRATION=true
