<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The Application layer owns the IAppDbContext abstraction that Infrastructure implements,
      so it needs the EF Core abstractions without taking a database provider dependency.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WorkoutTracker.Domain/WorkoutTracker.Domain.csproj" />
  </ItemGroup>
</Project>
